{
  "manifest_version": 3,
  "name": "Website Time Limiter",
  "version": "1.0.0",
  "description": "Set daily time limits for distracting websites and block access when the daily allowance is used.",
  "permissions": [
    "storage",
    "tabs",
    "idle",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Website Time Limiter"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "111"
}
